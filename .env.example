# ==============================================================================
# DIGITAL GROW LTD. - ENTERPRISE PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# ISO 27001 Security, SRE Telemetry, AI Search & SEO Readiness
# ==============================================================================

# 1. AI SEARCH & GEMINI API KEY
# Required for Gemini AI Consultant chatbot, SEO/GEO auto-generation, and schema enrichment.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. APP URL & DOMAIN CONFIGURATION
# Used for canonical SEO headers, XML sitemap generation, and OAuth/webhook callbacks.
APP_URL="https://digitalgrowltd.com"
NODE_ENV="production"

# 3. ENTERPRISE SECURITY & JWT CONFIGURATION
# Used for PBKDF2/JWT signing, admin portal credentials, and ISO 27001 session governance.
ADMIN_EMAIL="israt@digitalgrowltd.com"
ADMIN_PASSWORD="EnterpriseAdmin2026!"
ADMIN_2FA_CODE="7951"
ADMIN_JWT_SECRET="dgl_enterprise_secure_secret_key_2026_change_in_prod"
SESSION_TIMEOUT_MINS="60"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# 4. SMTP / TRANSACTIONAL EMAIL NOTIFICATIONS
# Required for instant consultation lead alerts, client PDF retainers, and password resets.
SMTP_HOST="smtp.digitalgrowltd.com"
SMTP_PORT=587
SMTP_USER="notifications@digitalgrowltd.com"
SMTP_PASS="secure_smtp_password"
ADMIN_NOTIFICATION_EMAIL="digitalgrowerltd@gmail.com"

# 5. ANALYTICS & SEARCH ENGINE CONFIGURATION (GA4, GSC, CLARITY)
# Placeholders for analytics telemetry and Google Search Console validation.
VITE_GA4_MEASUREMENT_ID="G-8XZ912QW8X"
VITE_GSC_VERIFICATION_CODE="dgl_gsc_verification_token_2026"
VITE_MICROSOFT_CLARITY_ID="dgl_clarity_project_id"
VITE_META_PIXEL_ID="dgl_meta_pixel_id"

# 6. AUTOMATED BACKUPS & DISASTER RECOVERY
# Frequency and retention parameters for automated JSON/SQL snapshot backups.
BACKUP_SCHEDULE_CRON="0 2 * * *"
BACKUP_RETENTION_DAYS="30"


